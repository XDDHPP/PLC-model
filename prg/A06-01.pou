PROGRAM A06-01//三轴码垛XYZ，真空吸  固定位置取料，放在8*8托盘
VAR

	流程: INT := 10;
	行: INT := 0;
	列: INT := 0;
	iStep: INT; // 分支位锁存计数器（bit0=轴1, bit1=轴2）
END_VAR

CASE 流程 OF
	10://真空破
		IF NOT tip.CylOut[1].xHomePos THEN
			Cyl.cmd[1].xAutoctr := TRUE;//真空启动
			Cyl.cmd[1].iAutoCtr := 1;//真空破
		ELSE
			Cyl.cmd[1].iAutoCtr := 0;//真空停止
			流程 := 20;
		END_IF;

	20://Z轴回上位
		IF NOT Tip.AXOUT[3].SVOUT.xHomeOK THEN
			Axis.Cmd[3].Autoin.xHome := TRUE;
		ELSE
			Axis.Cmd[3].Autoin.xHome := FALSE;
			流程 := 30;
		END_IF;

	//========== X,Y两轴同时去取料位 ==========
	30://触发两轴去取料位
		IF NOT Tip.AXOUT[1].SVOUT.xAbsOK THEN
			Axis.Cmd[1].Autoin.xAbs := TRUE;
			Axis.Cmd[1].iAposID := 1;//取料X位
		END_IF;
		IF NOT Tip.AXOUT[2].SVOUT.xAbsOK THEN
			Axis.Cmd[2].Autoin.xAbs := TRUE;
			Axis.Cmd[2].iAposID := 2;//取料Y位
		END_IF;
		iStep := 0;//清除位锁存
		IF Axis.Cmd[1].Autoin.xAbs AND Axis.Cmd[2].Autoin.xAbs THEN
			流程 := 35;
		END_IF;

	35://取料定位完成信号判断
		IF Sys.State.xAutoEna AND NOT Sys.State.xAutoStart THEN
			流程 := 30;
		END_IF;
		// 位锁存：bit0=轴1完成, bit1=轴2完成, 3=两轴都完成
		IF Tip.AXOUT[1].SVOUT.xAbsOK THEN
			iStep := iStep OR 1;
		END_IF;
		IF Tip.AXOUT[2].SVOUT.xAbsOK THEN
			iStep := iStep OR 2;
		END_IF;
		IF iStep = 3 THEN
			流程 := 40;
		END_IF;

	40://Z轴下降取料
		IF NOT Tip.AXOUT[3].SVOUT.xAbsOK THEN
			Axis.Cmd[3].Autoin.xAbs := TRUE;
			Axis.Cmd[3].iAposID := 4;//Z下位
		ELSE
			Axis.Cmd[3].iAposID := 0;
			流程 := 50;
		END_IF;

	50://真空吸
		IF NOT tip.CylOut[1].xWorkPos THEN
			Cyl.cmd[1].xAutoctr := TRUE;//真空启动
			Cyl.cmd[1].iAutoCtr := 2;//真空吸
		ELSE
			Cyl.cmd[1].iAutoCtr := 0;//真空停止
			流程 := 60;
		END_IF;

	60://Z轴上升
		IF NOT Tip.AXOUT[3].SVOUT.xHomeOK THEN
			Axis.Cmd[3].Autoin.xHome := TRUE;
		ELSE
			Axis.Cmd[3].Autoin.xHome := FALSE;
			流程 := 70;
		END_IF;

	//========== X,Y两轴同时去托盘位 ==========
	70://触发两轴去托盘位
		IF NOT Tip.AXOUT[1].SVOUT.xAbsOK THEN
			Axis.Cmd[1].Autoin.xAbs := TRUE;
			Axis.Cmd[1].iAposID := 10 + 列;//托盘X位
		END_IF;
		IF NOT Tip.AXOUT[2].SVOUT.xAbsOK THEN
			Axis.Cmd[2].Autoin.xAbs := TRUE;
			Axis.Cmd[2].iAposID := 20 + 行;//托盘Y位
		END_IF;
		iStep := 0;//清除位锁存
		IF Axis.Cmd[1].Autoin.xAbs AND Axis.Cmd[2].Autoin.xAbs THEN
			流程 := 75;
		END_IF;

	75://托盘定位完成信号判断
		IF Sys.State.xAutoEna AND NOT Sys.State.xAutoStart THEN
			流程 := 70;
		END_IF;
		// 位锁存：bit0=轴1完成, bit1=轴2完成, 3=两轴都完成
		IF Tip.AXOUT[1].SVOUT.xAbsOK THEN
			iStep := iStep OR 1;
		END_IF;
		IF Tip.AXOUT[2].SVOUT.xAbsOK THEN
			iStep := iStep OR 2;
		END_IF;
		IF iStep = 3 THEN
			流程 := 80;
		END_IF;

	80://Z轴下降放料
		IF NOT Tip.AXOUT[3].SVOUT.xAbsOK THEN
			Axis.Cmd[3].Autoin.xAbs := TRUE;
			Axis.Cmd[3].iAposID := 4;//Z下位
		ELSE
			Axis.Cmd[3].iAposID := 0;
			流程 := 90;
		END_IF;

	90://真空破
		IF NOT tip.CylOut[1].xHomePos THEN
			Cyl.cmd[1].xAutoctr := TRUE;//真空启动
			Cyl.cmd[1].iAutoCtr := 1;//真空破
		ELSE
			Cyl.cmd[1].iAutoCtr := 0;//真空停止
			流程 := 100;
		END_IF;

	100://Z轴上升
		IF NOT Tip.AXOUT[3].SVOUT.xHomeOK THEN
			Axis.Cmd[3].Autoin.xHome := TRUE;
		ELSE
			Axis.Cmd[3].Autoin.xHome := FALSE;
			流程 := 110;
		END_IF;

	110://更新行列，判断码垛是否完成
		// 清除轴命令，准备下一循环
		Axis.Cmd[1].Autoin.xAbs := FALSE;
		Axis.Cmd[2].Autoin.xAbs := FALSE;
		Axis.Cmd[1].iAposID := 0;
		Axis.Cmd[2].iAposID := 0;
		// 行列递增
		列 := 列 + 1;
		IF 列 >= 8 THEN
			列 := 0;
			行 := 行 + 1;
		END_IF;
		IF 行 >= 8 THEN
			行 := 0;
			列 := 0;
			流程 := 120;//码垛完成
		ELSE
			流程 := 30;//继续取料
		END_IF;

	120://码垛完成

END_CASE

END_PROGRAM
